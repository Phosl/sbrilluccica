# The app intentionally starts in mock mode. Switch these only when the real
# Supabase project and server-side integrations are ready.
DATA_PROVIDER=mock
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (future connection)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (optional; mock checkout is used when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MAP={}
STRIPE_SHIPPING_RATE_MAP={}
STRIPE_TAX_ENABLED=true
STRIPE_ADAPTIVE_PRICING_ENABLED=true

# Transactional email (optional; logged locally when unset)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
CONTACT_TO_EMAIL=
RESEND_NEWSLETTER_SEGMENT_ID=
NEWSLETTER_SIGNING_SECRET=

# Anonymous form protection. Set a long random value in production.
RATE_LIMIT_SALT=

# Consent/analytics (loaded only after a production configuration is supplied)
NEXT_PUBLIC_USERCENTRICS_SETTINGS_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
